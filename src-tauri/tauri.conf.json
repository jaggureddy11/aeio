{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aeio",
  "version": "0.1.0",
  "identifier": "com.aeio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aeio",
        "width": 640,
        "height": 480,
        "visible": true,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://localhost:11434 http://127.0.0.1:11434 http://localhost:8787 http://127.0.0.1:8787 https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://*.huggingface.co https://*.workers.dev ws://localhost:1420 http://localhost:1420;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/models/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://REPLACE_WITH_YOUR_DOMAIN/downloads/latest.json"
      ]
    }
  }
}
